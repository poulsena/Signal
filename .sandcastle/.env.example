# Exact model IDs returned by http://127.0.0.1:1337/v1/models.
SANDCASTLE_LOCAL_MODEL=qwen3.8-27b-mxfp8
SANDCASTLE_PLANNER_MODEL=openai-chatgpt/gpt-5.6-sol
SANDCASTLE_REVIEWER_MODEL=openai-chatgpt/gpt-5.6-sol

# The reviewer gets this many chances to reject the implementation and return
# it to the same local Pi session for repair.
SANDCASTLE_MAX_REVIEW_ROUNDS=3

# Must match the image built by `pnpm sandcastle:build`.
SANDCASTLE_IMAGE=signal-web-app-sandcastle
